{
  "name": "pjps-reference-checker-desktop",
  "productName": "PJPS Data Integrity System",
  "version": "3.1.3",
  "description": "PJPS Data Integrity System for Windows — the five PJPS modules with offline mode, by Softsols Pakistan",
  "author": "Softsols Pakistan",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node stage.js",
    "dist": "node stage.js && electron-builder --win --x64",
    "dist:dir": "node stage.js && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pk.softsols.pjps-reference-checker",
    "productName": "PJPS Data Integrity System",
    "copyright": "© Softsols Pakistan",
    "directories": {
      "app": "app",
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "desktop-config.json",
        "to": "desktop-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PJPS-Data-Integrity-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PJPS Data Integrity System",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PJPS-Data-Integrity-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PJPS-Data-Integrity-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://verifyref.vercel.app/api/desktop-app/update"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
