# PJPS Data Integration System — copy to .env and fill in (never commit .env)

# PostgreSQL connection string (Neon, Supabase, RDS, local…)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

PORT=3005
# Used in the polite User-Agent sent to Crossref/OpenAlex/PubMed
CONTACT_EMAIL=editor@pjps.pk

# First Super Admin (created on first start when none exists). All other users are created by the Super Admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Journal the checker runs for (used for citation-stacking checks)
HOME_JOURNAL_NAME=Pakistan Journal of Pharmaceutical Sciences
HOME_JOURNAL_ISSN=1011-601X

# Set to true when served over HTTPS (automatic on Vercel)
COOKIE_SECURE=false

# Vercel Cron: any long random string; Vercel sends it to /api/cron/daily
CRON_SECRET=

# Optional free API keys — strongly recommended for production volume
# OpenAlex: https://openalex.org/settings/api  (without a key, all users share a small daily budget per IP)
OPENALEX_API_KEY=
# Semantic Scholar: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=
# NCBI E-utilities: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Google Books: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Limits
MAX_REFERENCES=250
SESSION_DAYS=14

# E-mail notifications (alerts, retraction notices). Leave SMTP_HOST empty for in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public address of the web platform (used in e-mail links)
PUBLIC_URL=

# Large uploads (up to MAX_UPLOAD_MB) go from the browser straight to Cloudflare R2; without these, uploads stop at 4.5 MB on Vercel
MAX_UPLOAD_MB=500
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
