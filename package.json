{
  "name": "pjps-reference-checker",
  "version": "3.0.0",
  "description": "PJPS Reference Checker by Softsols Pakistan — reference integrity and research tools for the web and Windows desktop (offline mode)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/remediation.js && node test/smoke-web.js && node test/images-engine.mjs && node test/forensics.mjs && node test/demo-check.mjs && node test/pjps-style.js && node test/pharma-integrity.js",
    "desktop": "cd desktop && npm start",
    "desktop:dist": "cd desktop && npm run dist",
    "proposal": "node docs/build-proposal.js",
    "demo": "node demo/build-demo.js",
    "download:orange-book": "node scripts/download-orange-book.js",
    "download:ebsco": "node scripts/download-ebsco.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@vercel/functions": "^3.10.1",
    "@xmldom/xmldom": "^0.8.15",
    "docx": "^9.12.0",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "word-extractor": "^1.0.4"
  },
  "author": "Softsols Pakistan",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
