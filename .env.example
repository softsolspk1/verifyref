# PJPS Reference Checker — copy to .env and fill in (never commit .env)

# PostgreSQL connection string (Neon, Supabase, RDS, local…)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

PORT=3005
# Used in the polite User-Agent sent to Crossref/OpenAlex/PubMed
CONTACT_EMAIL=editor@pjps.pk

# First administrator (created on first start when no admin exists) — change the password after signing in
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Journal the checker runs for (used for citation-stacking checks)
HOME_JOURNAL_NAME=Pakistan Journal of Pharmaceutical Sciences
HOME_JOURNAL_ISSN=1011-601X

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Optional free API keys — strongly recommended for production volume
# OpenAlex: https://openalex.org/settings/api  (without a key, all users share a small daily budget per IP)
OPENALEX_API_KEY=
# Semantic Scholar: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=
# NCBI E-utilities: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Google Books: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Limits
MAX_REFERENCES=250
SESSION_DAYS=14
